# Port API
PORT=8080
# String koneksi PostgreSQL
DATABASE_URL=postgres://presensi:presensi@localhost:5432/presensi
# Rahasia JWT — WAJIB diganti di produksi (min 32 karakter acak)
JWT_SECRET=ganti-dengan-random-32-karakter
# Umur access token (detik)
ACCESS_TTL_SEC=900
# Umur refresh token (hari) — sesuai desain 30 hari
REFRESH_TTL_DAYS=30
# Origin web admin (pisahkan koma)
CORS_ORIGIN=http://localhost:3000
